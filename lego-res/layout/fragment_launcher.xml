<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_10sdp">

        <TextView
            android:id="@+id/lego_hello"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lego_home"
            android:textColor="@color/lego_yellow"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_142sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:orientation="horizontal">

            <!-- Tanlangan versiya: overworld rasmi + O'YNASH -->
            <FrameLayout
                android:id="@+id/lego_hero"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/_5sdp"
                android:layout_weight="1.55">

                <ImageView
                    android:id="@+id/lego_hero_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/lego_world_plains" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/lego_hero_scrim" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom"
                    android:orientation="vertical"
                    android:padding="@dimen/_10sdp">

                    <TextView
                        style="@style/LegoSection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lego_selected" />

                    <TextView
                        android:id="@+id/lego_hero_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:shadowColor="#000000"
                        android:shadowRadius="6"
                        android:singleLine="true"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/_16ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lego_hero_version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textColor="#E6E6E6"
                        android:textSize="@dimen/_9ssp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/play_button"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_40sdp"
                            android:layout_weight="1"
                            android:background="@drawable/lego_play_big"
                            android:letterSpacing="0.15"
                            android:text="@string/lego_play"
                            android:textAllCaps="true"
                            android:textColor="#1A1A1A"
                            android:textSize="@dimen/_14ssp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/edit_profile_button"
                            android:layout_width="@dimen/_40sdp"
                            android:layout_height="@dimen/_40sdp"
                            android:layout_marginStart="@dimen/_6sdp"
                            android:background="@drawable/lego_card"
                            android:contentDescription="@null"
                            android:padding="@dimen/_8sdp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_edit_profile" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Ko'rinmas: tanlangan profilni saqlash va yangi profilni olish uchun -->
                <com.kdt.mcgui.mcVersionSpinner
                    android:id="@+id/mc_version_spinner"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- O'rnatilgan versiyalar -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_weight="1"
                android:background="@drawable/lego_panel"
                android:orientation="vertical"
                android:padding="@dimen/_8sdp">

                <TextView
                    style="@style/LegoSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lego_versions" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lego_profiles_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:layout_weight="1"
                    android:clipToPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:orientation="horizontal">
        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/news_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="0dp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginHorizontal="@dimen/_3sdp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_menu_news"
            android:drawablePadding="@dimen/_5sdp"
            android:gravity="center_vertical|start"
            android:paddingStart="@dimen/_8sdp"
            android:singleLine="true"
            android:text="@string/mcl_tab_wiki"
            android:textSize="@dimen/_9ssp" />
        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/mods_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="0dp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginHorizontal="@dimen/_3sdp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_add_modded"
            android:drawablePadding="@dimen/_5sdp"
            android:gravity="center_vertical|start"
            android:paddingStart="@dimen/_8sdp"
            android:singleLine="true"
            android:text="@string/lego_mods"
            android:textSize="@dimen/_9ssp" />
        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/custom_control_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="0dp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginHorizontal="@dimen/_3sdp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_menu_custom_controls"
            android:drawablePadding="@dimen/_5sdp"
            android:gravity="center_vertical|start"
            android:paddingStart="@dimen/_8sdp"
            android:singleLine="true"
            android:text="@string/mcl_option_customcontrol"
            android:textSize="@dimen/_9ssp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:orientation="horizontal">
        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/install_jar_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="0dp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginHorizontal="@dimen/_3sdp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_menu_install_jar"
            android:drawablePadding="@dimen/_5sdp"
            android:gravity="center_vertical|start"
            android:paddingStart="@dimen/_8sdp"
            android:singleLine="true"
            android:text="@string/main_install_jar_file"
            android:textSize="@dimen/_9ssp" />
        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/share_logs_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="0dp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginHorizontal="@dimen/_3sdp"
            android:layout_weight="1"
            android:drawableStart="@android:drawable/ic_menu_share"
            android:drawablePadding="@dimen/_5sdp"
            android:gravity="center_vertical|start"
            android:paddingStart="@dimen/_8sdp"
            android:singleLine="true"
            android:text="@string/main_share_logs"
            android:textSize="@dimen/_9ssp" />
        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/open_files_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="0dp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginHorizontal="@dimen/_3sdp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_folder"
            android:drawablePadding="@dimen/_5sdp"
            android:gravity="center_vertical|start"
            android:paddingStart="@dimen/_8sdp"
            android:singleLine="true"
            android:text="@string/mcl_button_open_directory"
            android:textSize="@dimen/_9ssp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
