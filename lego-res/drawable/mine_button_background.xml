<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><corners android:radius="@dimen/_8sdp" />
            <solid android:color="@color/lego_disabled" /></shape>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item><shape android:shape="rectangle"><corners android:radius="@dimen/_8sdp" />
                <solid android:color="@color/lego_red_dark" /></shape></item>
            <item android:top="@dimen/_2sdp"><shape android:shape="rectangle"><corners android:radius="@dimen/_8sdp" />
                <solid android:color="#B00E10" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="rectangle"><corners android:radius="@dimen/_8sdp" />
                <solid android:color="@color/lego_red_dark" /></shape></item>
            <item android:bottom="@dimen/_2sdp"><shape android:shape="rectangle"><corners android:radius="@dimen/_8sdp" />
                <gradient android:angle="270" android:startColor="#EE2A2C" android:endColor="@color/lego_red" /></shape></item>
        </layer-list>
    </item>
</selector>
